# Clerk Authentication
# Get your Publishable Key from https://dashboard.clerk.com
# This is required for user authentication and authorization
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend API Configuration
# The base URL for your backend API server
# Default: http://localhost:8000/api (for local development)
# Production: https://your-backend-api-url.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Ngrok Configuration (Optional - for development/testing webhooks)
# Your ngrok authtoken from https://dashboard.ngrok.com
# Only needed if you're using ngrok for exposing local server
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
